#!/usr/bin/env python3
"""Render a social preview card for one article.

    bin/og-card _posts/2026-09-14-graphrag-explained.md

Writes assets/images/og/<slug>.png and prints the front-matter line to add.
Optional tooling: it needs Playwright with Chromium. Without it the site falls
back to the site-wide card in _config.yml, which is a perfectly good default —
this only makes a shared link show the article's own title.

    pip install playwright && playwright install chromium
"""
import glob
import html
import os
import pathlib
import re
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent

TEMPLATE = """<!doctype html><meta charset="utf-8">
<style>
  @font-face {{ font-family: Inter; src: url("{root}/assets/fonts/inter-latin.woff2"); font-weight: 400 600; }}
  @font-face {{ font-family: "Source Serif 4"; src: url("{root}/assets/fonts/source-serif-latin.woff2"); font-weight: 400 600; }}
  * {{ box-sizing: border-box; margin: 0; }}
  body {{ width: 1200px; height: 630px; display: flex; flex-direction: column;
          justify-content: space-between; padding: 72px 80px;
          background: #fbfaf7; font-family: Inter, sans-serif; color: #14181d; }}
  .kicker {{ font-size: 20px; font-weight: 500; letter-spacing: .14em;
             text-transform: uppercase; color: #616a74; }}
  h1 {{ margin-top: 30px; font-size: {size}px; font-weight: 600;
        letter-spacing: -.028em; line-height: 1.08; max-width: 1000px; }}
  p {{ margin-top: 26px; max-width: 880px; font-family: "Source Serif 4", Georgia, serif;
       font-size: 28px; line-height: 1.4; color: #2a3039; }}
  .rule {{ height: 1px; background: #e2dfd6; margin-bottom: 26px; }}
  footer {{ display: flex; justify-content: space-between; align-items: baseline;
            font-size: 22px; color: #59626d; }}
  .url {{ color: #1f4e79; font-weight: 500; }}
</style>
<body>
  <div>
    <div class="kicker">{kicker}</div>
    <h1>{title}</h1>
    {description}
  </div>
  <div>
    <div class="rule"></div>
    <footer><span>Sven Lutz</span><span class="url">sven-lutz.github.io</span></footer>
  </div>
</body>"""


def front_matter(path: pathlib.Path) -> dict:
    text = path.read_text(encoding="utf-8")
    match = re.match(r"^---\n(.*?)\n---", text, re.S)
    if not match:
        sys.exit(f"{path} has no front matter")
    fields = {}
    for line in match.group(1).splitlines():
        if re.match(r"^\w[\w-]*:", line):
            key, _, value = line.partition(":")
            fields[key.strip()] = value.strip().strip('"').strip("'")
    return fields


def launch_options() -> dict:
    """Use Playwright's own browser when it has one, otherwise a Chromium already
    on this machine — set CHROMIUM_PATH to point at a specific binary."""
    explicit = os.environ.get("CHROMIUM_PATH")
    if explicit and pathlib.Path(explicit).exists():
        return {"executable_path": explicit}

    candidates = [
        *glob.glob("/opt/pw-browsers/chromium-*/chrome-linux/chrome"),
        "/usr/bin/chromium",
        "/usr/bin/chromium-browser",
        "/usr/bin/google-chrome",
        "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
    ]
    for candidate in candidates:
        if pathlib.Path(candidate).exists():
            return {"executable_path": candidate}
    return {}


def main() -> None:
    if len(sys.argv) != 2:
        sys.exit(__doc__)

    source = pathlib.Path(sys.argv[1])
    if not source.exists():
        sys.exit(f"No such file: {source}")

    fields = front_matter(source)
    title = fields.get("title") or source.stem
    slug = re.sub(r"^\d{4}-\d{2}-\d{2}-", "", source.stem)

    try:
        from playwright.sync_api import sync_playwright
    except ImportError:
        sys.exit("Playwright is not installed. See the header of this script.")

    # Long titles get a smaller face rather than an overflowing box.
    size = 76 if len(title) <= 46 else 64 if len(title) <= 70 else 54
    description = f"<p>{html.escape(fields['description'])}</p>" if fields.get("description") else ""

    page_html = TEMPLATE.format(
        root=ROOT.as_uri(),
        size=size,
        kicker=html.escape(fields.get("category", "Article")),
        title=html.escape(title),
        description=description,
    )

    out_dir = ROOT / "assets" / "images" / "og"
    out_dir.mkdir(parents=True, exist_ok=True)
    out_file = out_dir / f"{slug}.png"

    scratch = out_dir / "_card.html"
    scratch.write_text(page_html, encoding="utf-8")
    try:
        with sync_playwright() as p:
            browser = p.chromium.launch(**launch_options())
            page = browser.new_page(viewport={"width": 1200, "height": 630})
            page.goto(scratch.as_uri(), wait_until="networkidle")
            page.wait_for_timeout(500)
            page.screenshot(path=str(out_file))
            browser.close()
    finally:
        scratch.unlink(missing_ok=True)

    print(f"Wrote {out_file.relative_to(ROOT)}")
    print("\nAdd this line to the article's front matter:\n")
    print(f"image: /assets/images/og/{slug}.png")


if __name__ == "__main__":
    main()
